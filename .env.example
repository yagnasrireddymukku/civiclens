# Root-level reference only — no process reads this file directly.
#
# Next.js loads env files from apps/web/.env.local; FastAPI loads them from
# apps/api/.env. Copy the per-app .env.example into place there:
#
#   cp apps/web/.env.example apps/web/.env.local
#   cp apps/api/.env.example apps/api/.env
#
# Never commit a real .env/.env.local file — see CLAUDE.md rule 15 and
# docs/SECURITY.md.

# --- Application environment -------------------------------------------
# One of: local, test, staging, production (apps/api), consistent
# across both apps for a given deploy.
APP_ENV=local

# --- Frontend <-> backend wiring ----------------------------------------
# apps/web: base URL the frontend uses to call the backend API.
NEXT_PUBLIC_API_URL=http://localhost:8000

# apps/api: origins allowed to call the API (CORS).
CORS_ALLOW_ORIGINS=["http://localhost:3000"]

# --- Database (config only — unused until docs/ROADMAP.md Phase 3) ------
DATABASE_URL=postgresql+psycopg://civiclens:civiclens@localhost:5432/civiclens_dev

# --- Future categories (not implemented; documented ahead of need) ------
# Redis (if a caching/queue need is documented — none exists yet):
# REDIS_URL=
# AI provider configuration (docs/AI_ARCHITECTURE.md, Phase 11):
# LLM_PROVIDER=
# LLM_API_KEY=
# Auth (docs/ADR/ADR-009-authentication-strategy.md, later phase):
# JWT_SECRET_KEY=
# JWT_ACCESS_TOKEN_TTL_MINUTES=15

# Copy to .env for local development. Never commit a real .env file —
# see CLAUDE.md rule 15 and docs/SECURITY.md.

# One of: local, test, staging, production
APP_ENV=local

# Comma-separated list is not supported here; pydantic-settings parses a
# JSON array from the env var, e.g.: '["http://localhost:3000"]'
CORS_ALLOW_ORIGINS=["http://localhost:3000"]

LOG_LEVEL=INFO

# Not used until docs/ROADMAP.md Phase 3 — safe local-only placeholder,
# never a real host/credential.
DATABASE_URL=postgresql+psycopg://civiclens:civiclens@localhost:5432/civiclens_dev

# Civic AI / RAG (Phase 12, docs/AI_ARCHITECTURE.md). Leave both provider
# settings as "none" (the default) to run with AI fully disabled — the
# app builds, boots, and tests without any of the below set. Never put a
# real key in this file; set AI_LLM_API_KEY / AI_EMBEDDING_API_KEY in your
# own untracked .env only.
AI_LLM_PROVIDER=none
AI_LLM_API_KEY=
AI_LLM_MODEL=claude-haiku-4-5-20251001
AI_EMBEDDING_PROVIDER=none
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=text-embedding-3-small
